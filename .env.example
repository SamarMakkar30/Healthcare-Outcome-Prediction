# Healthcare Prediction System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Healthcare Prediction System"
APP_VERSION="2.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# =============================================================================
# API SETTINGS
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_PREFIX=/api/v1

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# DATABASE SETTINGS (if using database)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_db
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# =============================================================================
# MODEL SETTINGS
# =============================================================================
MODEL_REGISTRY_PATH=./models/registry
MODEL_ARTIFACTS_PATH=./models/artifacts

# Classification thresholds (recall-optimized)
DIABETES_THRESHOLD=0.35
HEART_DISEASE_THRESHOLD=0.40
STROKE_THRESHOLD=0.30

# False negative cost multipliers
DIABETES_FN_COST=3.0
HEART_DISEASE_FN_COST=5.0
STROKE_FN_COST=8.0

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=./logs/app.log
AUDIT_LOG_PATH=./logs/audit.log

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090

# Drift detection
DRIFT_CHECK_INTERVAL_HOURS=24
DRIFT_THRESHOLD_KS=0.1
DRIFT_THRESHOLD_PSI=0.2

# =============================================================================
# REDIS SETTINGS (for caching/rate limiting)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# CACHE_TTL_SECONDS=3600

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# MLFLOW_TRACKING_URI=http://localhost:5000
# PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SHAP_EXPLANATIONS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_DRIFT_DETECTION=true
ENABLE_RATE_LIMITING=true
